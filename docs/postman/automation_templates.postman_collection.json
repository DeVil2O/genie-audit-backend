{
  "info": {
    "_postman_id": "c3f7f6c5-8f7b-4b1c-8f43-templates",
    "name": "Genie Audit API (MVP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public ingest + private CRUD (projects, inboxes, automations, logs, templates)"
  },
  "item": [
    {
      "name": "Ingest Event (public)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/i/{{token}}",
          "host": ["{{base_url}}"],
          "path": ["i", "{{token}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hello\": \"world\"\n}"
        }
      }
    },
    {
      "name": "Create Project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/projects",
          "host": ["{{base_url}}"],
          "path": ["v1", "projects"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"My Project\"\n}"
        }
      }
    },
    {
      "name": "Create Inbox",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/inboxes",
          "host": ["{{base_url}}"],
          "path": ["v1", "inboxes"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"name\": \"My Inbox\"\n}"
        }
      }
    },
    {
      "name": "List Inboxes",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/inboxes?project_id={{project_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "inboxes"],
          "query": [
            { "key": "project_id", "value": "{{project_id}}" }
          ]
        }
      }
    },
    {
      "name": "Create Automation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/automations",
          "host": ["{{base_url}}"],
          "path": ["v1", "automations"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"name\": \"Sample Automation\",\n  \"inboxId\": \"{{inbox_id}}\",\n  \"graphJson\": {\"nodes\": [], \"edges\": []}\n}"
        }
      }
    },
    {
      "name": "List Automations",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/automations?project_id={{project_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "automations"],
          "query": [
            { "key": "project_id", "value": "{{project_id}}" }
          ]
        }
      }
    },
    {
      "name": "Get Automation",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
