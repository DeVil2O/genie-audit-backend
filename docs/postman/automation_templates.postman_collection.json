          "raw": "{{base_url}}/v1/automations/{{automation_id}}?project_id={{project_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "automations", "{{automation_id}}"],
          "query": [
            { "key": "project_id", "value": "{{project_id}}" }
          ]
        }
      }
    },
    {
      "name": "Update Automation",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/automations/{{automation_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "automations", "{{automation_id}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"enabled\": true\n}"
        }
      }
    },
    {
      "name": "List Events",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/events?inboxId={{inbox_id}}&limit=50",
          "host": ["{{base_url}}"],
          "path": ["v1", "events"],
          "query": [
            { "key": "inboxId", "value": "{{inbox_id}}" },
            { "key": "limit", "value": "50" }
          ]
        }
      }
    },
    {
      "name": "Get Event",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/events/{{event_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "events", "{{event_id}}"]
        }
      }
    },
    {
      "name": "Replay Event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/events/{{event_id}}/replay",
          "host": ["{{base_url}}"],
          "path": ["v1", "events", "{{event_id}}", "replay"]
