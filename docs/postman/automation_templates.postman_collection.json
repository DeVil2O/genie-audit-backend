      }
    },
    {
      "name": "List Runs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/runs?automationId={{automation_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "runs"],
          "query": [
            { "key": "automationId", "value": "{{automation_id}}" }
          ]
        }
      }
    },
    {
      "name": "List Deliveries",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/deliveries?runId={{run_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "deliveries"],
          "query": [
            { "key": "runId", "value": "{{run_id}}" }
          ]
        }
      }
    },
    {
      "name": "Create Template",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/templates",
          "host": ["{{base_url}}"],
          "path": ["v1", "templates"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sample Flow\",\n  \"description\": \"Demo React Flow graph\",\n  \"tags\": [\"demo\", \"webhook\"],\n  \"graphJson\": {\n    \"nodes\": [\n      {\"id\": \"n1\", \"type\": \"trigger.webhook\", \"data\": {}, \"position\": {\"x\": 0, \"y\": 0}}\n    ],\n    \"edges\": []\n  },\n  \"visibility\": \"private\",\n  \"createdByProjectId\": null\n}"
        }
      }
    },
    {
      "name": "List Templates",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/templates?visibility=public&tag=demo",
          "host": ["{{base_url}}"],
          "path": ["v1", "templates"],
          "query": [
            { "key": "visibility", "value": "public" },
            { "key": "tag", "value": "demo" }
          ]
        }
      }
    },
    {
      "name": "Get Template",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/v1/templates/{{template_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "templates", "{{template_id}}"]
        }
      }
    },
    {
      "name": "Update Template",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/templates/{{template_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "templates", "{{template_id}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated description\",\n  \"tags\": [\"demo\", \"updated\"],\n  \"visibility\": \"public\"\n}"
        }
      }
    }
